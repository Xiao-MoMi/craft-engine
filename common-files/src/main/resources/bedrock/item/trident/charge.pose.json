{
  "pre_animation": [
    "variable.ce_trident_time = variable.ce_use_ticks + query.frame_alpha - 1;",
    "variable.ce_trident_charge = math.min(1, variable.ce_trident_time / 10);",
    "variable.ce_trident_shake = variable.ce_trident_charge > 0.1 ? math.sin((variable.ce_trident_time - 0.1) * 1.3 * 180 / math.pi) * (variable.ce_trident_charge - 0.1) * 0.064 : 0;",
    "variable.ce_trident_side = context.item_slot == 'off_hand' ? -1 : 1;"
  ],
  "bones": [
    { "name": "ce_trident_x", "parent": "ce_slot", "pivot": [0, 8, 0] },
    { "name": "ce_trident_y", "parent": "ce_trident_x", "pivot": [0, 8, 0] },
    { "name": "ce_trident_z", "parent": "ce_trident_y", "pivot": [0, 8, 0] },
    { "name": "ce_trident_charge", "parent": "ce_trident_z", "pivot": [0, 8, 0] },
    { "name": "ce_trident_aim", "parent": "ce_trident_charge", "pivot": [0, 8, 0] }
  ],
  "animate": [
    { "java_trident_charge": "context.is_first_person && variable.ce_using_item" }
  ],
  "animations": {
    "java_trident_charge": {
      "loop": true,
      "bones": {
        "ce_trident_x": { "position": ["variable.ce_trident_side * 8", 11.2, 1.6], "rotation": [55, 0, 0] },
        "ce_trident_y": { "rotation": [0, "-variable.ce_trident_side * 35.3", 0] },
        "ce_trident_z": { "rotation": [0, 0, "-variable.ce_trident_side * 9.785"] },
        "ce_trident_charge": {
          "position": [0, "variable.ce_trident_shake", "variable.ce_trident_charge * 3.2"],
          "scale": [1, 1, "1 + variable.ce_trident_charge * 0.2"]
        },
        "ce_trident_aim": { "rotation": [0, "variable.ce_trident_side * 45", 0] }
      }
    }
  }
}
