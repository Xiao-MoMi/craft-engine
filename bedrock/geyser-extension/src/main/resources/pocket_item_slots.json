{
  "ui/ui_common.json": {
    "namespace": "common",
    "pocket_ui_container_item": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "scroll_panel_pocket": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "ce_pocket_block_slot": {
      "type": "stack_panel",
      "orientation": "horizontal",
      "controls": [
        {
          "margin": {
            "type": "panel",
            "size": [4, 1],
            "bindings": [
              { "binding_type": "collection", "binding_collection_name": "$item_collection_name", "binding_name": "#item_id_aux", "binding_name_override": "#ce_aux" },
              { "binding_type": "view", "source_property_name": "(#ce_aux / 65536)", "target_property_name": "#ce_id" },
              { "binding_type": "view", "source_property_name": "((#ce_id > (#ce_first - 1)) and (#ce_id < #ce_end))", "target_property_name": "#ce_in_range" },
              { "binding_type": "view", "source_property_name": "(#ce_in_range * ((#ce_id - #ce_first) + 1))", "target_property_name": "#ce_length" },
              { "binding_type": "view", "source_property_name": "((('%.' + #ce_length + 's') * #ce_mask) + '/')", "target_property_name": "#ce_prefix" },
              { "binding_type": "view", "source_property_name": "(not ((#ce_prefix - '1/') = #ce_prefix))", "target_property_name": "#ce_last_bit" },
              { "binding_type": "view", "source_property_name": "(#ce_in_range and #ce_last_bit)", "target_property_name": "#visible" }
            ]
          }
        },
        { "icon@common.item_renderer": { "size": "$item_renderer_size" } }
      ]
    }
  },
  "ui/inventory_screen_pocket.json": {
    "namespace": "crafting_pocket",
    "recipe_book_scroll_panel_pocket": { "$grid_item_template": "crafting_pocket.ce_recipe_book_slot" },
    "ce_recipe_book_slot@crafting.grid_item_for_recipe_book": { "$item_renderer": "common.ce_pocket_block_slot" },
    "grid_item_for_inventory": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "hotbar_grid_item": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "crafting_input_grid_item": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "output_grid/work_bench_output": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "pocket_armor_tab_content/equipment_and_renderer/equipment/armor_grid": { "$item_renderer|default": "common.ce_pocket_block_slot" },
    "pocket_armor_tab_content/equipment_and_renderer/equipment/offhand_grid": { "$item_renderer|default": "common.ce_pocket_block_slot" }
  },
  "ui/furnace_screen_pocket.json": {
    "namespace": "furnace_pocket",
    "scroll_panel_pocket": { "$item_renderer|default": "common.ce_pocket_block_slot" }
  },
  "ui/trade_2_screen_pocket.json": {
    "namespace": "trade2_pocket",
    "left_panel/content/trade_scroll_panel": { "$item_renderer|default": "common.ce_pocket_block_slot" }
  }
}
